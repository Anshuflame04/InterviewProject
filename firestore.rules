rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The frontend directly stores a user's LLM configuration here. This
    // match is deliberately owner-only because it may contain an API key.
    match /users/{userId}/private/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Application data is normally written by the authenticated backend
    // through Firebase Admin. Keep direct browser access owner-scoped.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
